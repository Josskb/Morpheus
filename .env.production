# ══════════════════════════════════════════════════════════════════
#  financial-radar — Production Configuration (Proxmox)
#  Copy to .env and fill in your credentials
# ══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
TZ=Europe/Paris

# ── Database ──────────────────────────────────────────────────────
# Production: PostgreSQL via Docker Compose
# DATABASE_URL is auto-set by docker-compose.yml
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_prod_pass      # Change this to a strong password!

# ── Twitter API v2 (Free Tier) ────────────────────────────────────
# Get from https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=                   # Your Bearer Token here
TWITTER_API_KEY=                        # Optional for free tier
TWITTER_API_SECRET=                     # Optional for free tier
TWITTER_ACCESS_TOKEN=                   # Optional for free tier
TWITTER_ACCESS_SECRET=                  # Optional for free tier

# Tier : free | basic | pro
TWITTER_TIER=free

# ── Market Data ───────────────────────────────────────────────────
# yfinance doesn't require API keys
# For ccxt (Binance example - read-only)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Telegram Bot (Alerts) ────────────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=                     # Your bot token
TELEGRAM_CHAT_ID=                       # Your chat ID for alerts

# ── Alerting Configuration ────────────────────────────────────────
MIN_CONFIDENCE_SCORE=0.65               # Minimum confidence for alert
ALERT_COOLDOWN_MINUTES=5                # Cooldown between alerts per account
