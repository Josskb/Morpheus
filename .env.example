# ══════════════════════════════════════════════════════════════════
#  financial-radar — Variables d'environnement
#  Copie ce fichier en .env et remplis les valeurs
# ══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
TZ=Europe/Paris

# ── Database ──────────────────────────────────────────────────────
# SQLite (dev) : sqlite+aiosqlite:///./data/radar.db
# PostgreSQL (prod) : postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/radar.db

# ── Twitter API v2 ────────────────────────────────────────────────
# Récupère sur developer.twitter.com → tes app credentials
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Tier : free | basic | pro
TWITTER_TIER=free

# ── Market Data ───────────────────────────────────────────────────
# yfinance ne nécessite pas de clé
# Pour ccxt — exemple Binance (lecture seule suffit)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Telegram Bot ─────────────────────────────────────────────────
# Crée ton bot via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alertes ───────────────────────────────────────────────────────
MIN_CONFIDENCE_SCORE=0.65    # Seuil minimum pour envoyer une alerte
ALERT_COOLDOWN_MINUTES=5     # Délai entre alertes du même compte

# ── Récap Telegram ──────────────────────────────────────────────────
DIGEST_INTERVAL_MINUTES=30   # Fréquence du récap des signaux sous le seuil
DAILY_RECAP_HOUR_UTC=6       # Heure UTC d'envoi du récap quotidien
ALERT_RECAP_INTERVAL_HOURS=2 # Fréquence du récap des signaux forts

# ── ML ────────────────────────────────────────────────────────────
ML_EVALUATION_WINDOW=24h        # Fenêtre utilisée pour juger un call profitable : 1h|4h|24h|7d
ML_MIN_TRAINING_SAMPLES=50      # Échantillons labellisés minimum avant d'entraîner un modèle
ML_SCORE_THRESHOLD=0.5          # Seuil ml_score pour predicted_profitable
